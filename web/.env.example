# NextAuth
NEXTAUTH_URL=https://your-domain.railway.app
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Google OAuth (console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID)
# Authorized redirect URI: https://your-domain.railway.app/api/auth/callback/google
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Postgres (Railway injects this automatically)
DATABASE_URL=postgresql://postgres:password@host:port/railway

# Comma-separated emails that can see ALL meetings (everyone else sees only their own)
LEADERSHIP_EMAILS=dominic@trovatrip.com,ceo@trovatrip.com
